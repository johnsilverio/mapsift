# Mapsift API environment template.
#
# Copy to `.env` and fill in real values for local development. `.env` is ignored by git and
# `.env.example` is tracked, because a template with no real values is documentation while a
# file with real values is a leak that lives in the history forever (ADR-0001 section 4, PRD N3).
#
# Every variable here is validated at startup by config/env.py. A missing SECRET_KEY or
# DATABASE_URL stops the process rather than falling back to something that looks like it works.

# Required. Generate a fresh one per environment and never reuse it across them.
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Required. Note the scheme: `postgresql://`, never `postgis://`, which is not a valid URL
# scheme and which the validator rejects. PostGIS is selected by Django's database ENGINE,
# not by the URL. The host is the compose service name once the container step lands.
#
# The user is the migrate profile of ADR-0005 section 2, never the cluster superuser: the suite
# has to run as a role the wall applies to, or it proves nothing. The port is the published one
# from infra/.env, because this file configures a run from the host rather than the container.
DATABASE_URL=postgresql://mapsift_owner:mapsift_owner@localhost:5433/mapsift

# Optional. Off unless set, so forgetting it cannot expose a stack trace.
DEBUG=false

# Optional. Comma separated, which is what a person writes; a JSON array is not expected here.
ALLOWED_HOSTS=localhost,127.0.0.1
