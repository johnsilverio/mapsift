# Mapsift compose environment template (ADR-0001 section 4: configuration comes from the
# environment, never from a checked-in file with real values).
#
# Copy to infra/.env, which is ignored by git. `just setup` does it for you.
#
# Everything here is development-only. No production credential and no production data exists in
# any non-production environment (foundation I7, C6, PRD N3), so a value in this file is never
# reused anywhere real, and the deployment configuration is a separate file with separate values.

# The database container creates this role and database on first start. Changing any of them
# after the volume exists does nothing, because the cluster is already initialised: run
# `just reset` first.
#
# This one is the cluster superuser, and it is used at provisioning and by nothing else
# (ADR-0005 section 2). The API connects as the owner below.
POSTGRES_DB=mapsift
POSTGRES_USER=mapsift
POSTGRES_PASSWORD=mapsift

# The migrate profile: owns the schema, runs migrations, and is what the test suite connects as.
# Not a superuser and without BYPASSRLS, which is what makes the suite prove the wall instead of
# walking around it. Created by infra/docker/db/30-mapsift-owner.sh on first start.
DB_OWNER_PASSWORD=mapsift_owner

# Django's SECRET_KEY for the container. Generate a real one per environment:
#   just manage shell -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
API_SECRET_KEY=development-only-not-a-production-secret

# Host ports. Change one when something already listens there; the container ports never move.
# The database is published on 5433 because a developer machine usually already runs a system
# PostgreSQL on 5432, and this port is only for reaching the container from the host: the API
# talks to it over the compose network, where the port is the usual one.
DB_PORT=5433
API_PORT=8000
WEB_PORT=4200
