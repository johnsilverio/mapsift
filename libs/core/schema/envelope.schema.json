{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppliedOperation",
  "description": "An operation the server has applied: both halves, side by side and separately addressable.",
  "type": "object",
  "properties": {
    "client": {
      "$ref": "#/$defs/ClientHalf"
    },
    "server": {
      "$ref": "#/$defs/ServerHalf"
    }
  },
  "required": [
    "client",
    "server"
  ],
  "$defs": {
    "ClientHalf": {
      "description": "An operation as the client authored it. Every field here is the client's claim; nothing in it\nis authoritative until the server half exists beside it.",
      "type": "object",
      "properties": {
        "author_session_material": {
          "description": "Opaque to the core: the proof mechanism is OQ-18's and the server is what verifies it."
        },
        "client_id": {
          "type": "string",
          "format": "uuid"
        },
        "conflict_rule_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "mediation": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediationProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "mutation_number": {
          "description": "The per-client monotonic axis the server dedups a resent flush by (C12).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "operation_schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "discriminator": {
        "propertyName": "operation_type"
      },
      "oneOf": [
        {
          "title": "FeatureCreateOperation",
          "type": "object",
          "properties": {
            "operation_type": {
              "type": "string",
              "const": "feature.create"
            },
            "payload": {
              "$ref": "#/$defs/FeatureCreatePayload"
            },
            "target": {
              "$ref": "#/$defs/FeatureTarget"
            }
          },
          "required": [
            "operation_type",
            "target",
            "payload"
          ]
        },
        {
          "title": "FeatureGeometrySetOperation",
          "type": "object",
          "properties": {
            "operation_type": {
              "type": "string",
              "const": "feature.geometry.set"
            },
            "payload": {
              "$ref": "#/$defs/FeatureGeometrySetPayload"
            },
            "target": {
              "$ref": "#/$defs/PropertyTarget"
            }
          },
          "required": [
            "operation_type",
            "target",
            "payload"
          ]
        }
      ],
      "required": [
        "operation_id",
        "client_id",
        "mutation_number",
        "operation_schema_version",
        "conflict_rule_version",
        "author_session_material",
        "created_at",
        "mediation"
      ]
    },
    "FeatureCreatePayload": {
      "description": "What creating a feature carries: nothing beyond the address it creates. Everything the feature\nthen holds arrives as the operations that address it (M9, M15).",
      "type": "object"
    },
    "FeatureGeometrySetPayload": {
      "description": "The whole geometry the feature is being set to, never a vertex delta, because\npreserve-not-discard needs both whole versions presentable (M9, C7).",
      "type": "object",
      "properties": {
        "geometry": {
          "description": "A GeoJSON-shaped structure in the M5 storage frame. Opaque to the core until the boundary\nencoding is decided (MAP-33)."
        }
      },
      "required": [
        "geometry"
      ]
    },
    "FeatureTarget": {
      "description": "A whole-feature address, carrying its ancestors so it resolves without a lookup (M9).",
      "oneOf": [
        {
          "title": "FeatureAddress",
          "type": "object",
          "properties": {
            "feature_id": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "type": "string",
              "const": "feature"
            },
            "layer_id": {
              "type": "string",
              "format": "uuid"
            },
            "project_id": {
              "type": "string",
              "format": "uuid"
            },
            "tenant_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "tenant_id",
            "project_id",
            "layer_id",
            "feature_id"
          ]
        }
      ]
    },
    "MediationProvenance": {
      "description": "Present when the write reached the queue through an agent acting for the author, absent when\nthe author wrote directly (C14).",
      "type": "object",
      "properties": {
        "agent": {
          "type": "string"
        }
      },
      "required": [
        "agent"
      ]
    },
    "PropertyTarget": {
      "description": "One property of one feature, the finest granularity the ladder measures a conflict on (M9).",
      "oneOf": [
        {
          "title": "PropertyAddress",
          "type": "object",
          "properties": {
            "feature_id": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "type": "string",
              "const": "property"
            },
            "layer_id": {
              "type": "string",
              "format": "uuid"
            },
            "project_id": {
              "type": "string",
              "format": "uuid"
            },
            "property": {
              "type": "string"
            },
            "tenant_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "tenant_id",
            "project_id",
            "layer_id",
            "feature_id",
            "property"
          ]
        }
      ]
    },
    "ServerHalf": {
      "description": "What the server added when it applied the operation. Authoritative, and never merged into the\nclient's half.",
      "type": "object",
      "properties": {
        "applied_at": {
          "type": "string",
          "format": "date-time"
        },
        "applied_rule_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "feature_version": {
          "description": "The per-feature axis that orders and detects conflict on one feature (M10).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "legal_weight_in_force": {
          "type": "boolean"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "applied_at",
        "feature_version",
        "applied_rule_version",
        "legal_weight_in_force",
        "verdict"
      ]
    },
    "Verdict": {
      "description": "What the server decided about the operation. A closed set, declared by M13 and grown\nadditively.",
      "type": "string",
      "enum": [
        "applied"
      ]
    }
  }
}
